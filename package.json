{
  "dependencies": {
    "express": "^4.21.2",
    "mongoose": "^8.12.2",
    "remixicon": "^4.6.0"
  },
  "name": "beaver-lfp",
  "version": "1.0.0",
  "description": "CSE 416 Spring 2025, Team Beaver: Lifetime Financial Planner",
  "scripts": {
    "start": "concurrently \"npm run server\" \"npm run client\"",
    "server": "cd backend && npm run start",
    "client": "cd frontend && npm run start",
    "install-all": "npm install && npm run install-client && npm run install-server",
    "install-client": "cd frontend && npm install",
    "install-server": "cd backend && npm install",
    "test": "concurrently \"npm test:server\" \"npm test:client\"",
    "test:server": "cd backend && npm run test",
    "test:client": "cd frontend && npm run test"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
